<?xml version="1.0" encoding="UTF-8"?>
<!-- prod resolve, twice daily: incrementally grow the corpus from the backlog. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.randomify.prod-resolve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/resolve.sh</string>
    <string>production</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>18</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__REPO__/data/musicbrainz/logs/prod-resolve.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/musicbrainz/logs/prod-resolve.log</string>
</dict>
</plist>
